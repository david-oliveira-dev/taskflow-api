# Copy to .env and adjust. Never commit .env — only this file is versioned.
# The values below are fake and match docker-compose.yml, so `docker compose up`
# works with a straight copy.

# local | ci | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Async DSN: the driver must be asyncpg, not psycopg.
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow

REDIS_URL=redis://localhost:6379/0

# Signing key for access tokens. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-this-placeholder-is-public-and-fake-and-long-enough
JWT_ALGORITHM=HS256
# Minutes (1-60). Short on purpose: there is no refresh token and no revocation,
# so this window is the security boundary.
ACCESS_TOKEN_TTL_MINUTES=15

# Rate limiting: a sliding window per account (or per address when unauthenticated).
# Generous on purpose — the point is to stop a runaway client, not to shape ordinary
# traffic. A limit tight enough to trip in normal use just trains people to ignore 429s.
# If Redis is unreachable the limiter fails open: requests pass, a WARNING is logged, and
# the response is marked X-RateLimit-Degraded.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
